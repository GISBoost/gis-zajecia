---
// A pipeline drawn as a transit line: the page's 5-line bundle runs through one station per
// step and ends at an ink terminus. Horizontal on desktop, vertical on narrow screens.
interface Step { name: string; data: string; text: string }
interface Props { steps: Step[]; end: Step }
const { steps, end } = Astro.props;
---
<ol class="pipe" style={`--n:${steps.length + 1}`}>
  {[...steps, end].map((s, i) => (
    <li class:list={['stop', { end: i === steps.length }]} data-reveal>
      <span class="node" aria-hidden="true"></span>
      <span class="data">{s.data}</span>
      <b>{s.name}</b>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
<style>
  .pipe{--lw:6px;--lg:3px;--bw:calc(5 * var(--lw) + 4 * var(--lg));list-style:none;margin:32px 0 0;padding:0;position:relative;display:grid;grid-template-columns:repeat(var(--n),1fr);gap:0 18px}
  /* The bundle: five coloured lines with paper gaps, from the first node to the terminus. */
  .pipe::before{content:'';position:absolute;top:18px;left:calc(100% / var(--n) / 2);right:calc(100% / var(--n) / 2);height:var(--bw);transform:translateY(-50%);
    background:linear-gradient(to bottom,
      var(--line-vermilion) 0 var(--lw),transparent 0 calc(var(--lw) + var(--lg)),
      var(--line-orange) 0 calc(2 * var(--lw) + var(--lg)),transparent 0 calc(2 * var(--lw) + 2 * var(--lg)),
      var(--line-yellow) 0 calc(3 * var(--lw) + 2 * var(--lg)),transparent 0 calc(3 * var(--lw) + 3 * var(--lg)),
      var(--line-sky) 0 calc(4 * var(--lw) + 3 * var(--lg)),transparent 0 calc(4 * var(--lw) + 4 * var(--lg)),
      var(--line-blue) 0 var(--bw))}
  .stop{position:relative;text-align:center;padding-top:44px}
  /* Station node: the same paper pill with an ink outline as on the side journey line. */
  .node{position:absolute;top:18px;left:50%;width:calc(var(--bw) + 18px);height:20px;transform:translate(-50%,-50%);border:3px solid var(--ink);border-radius:999px;background:var(--paper);box-sizing:border-box}
  .end .node{background:var(--ink)}
  .data{display:inline-block;font:700 11px/1 var(--font-condensed);letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;border:2px solid var(--ink);padding:4px 7px;margin-bottom:10px;background:var(--white)}
  .end .data{background:var(--ink);color:var(--paper)}
  b{display:block;font:700 18px/1.2 var(--font-sans,inherit);margin-bottom:6px}
  p{margin:0;font-size:14px;line-height:1.45}
  @media (max-width:860px){
    .pipe{grid-template-columns:1fr;gap:22px}
    .pipe::before{top:18px;bottom:18px;left:24px;right:auto;width:var(--bw);height:auto;transform:translateX(-50%);
      background:linear-gradient(to right,
        var(--line-vermilion) 0 var(--lw),transparent 0 calc(var(--lw) + var(--lg)),
        var(--line-orange) 0 calc(2 * var(--lw) + var(--lg)),transparent 0 calc(2 * var(--lw) + 2 * var(--lg)),
        var(--line-yellow) 0 calc(3 * var(--lw) + 2 * var(--lg)),transparent 0 calc(3 * var(--lw) + 3 * var(--lg)),
        var(--line-sky) 0 calc(4 * var(--lw) + 3 * var(--lg)),transparent 0 calc(4 * var(--lw) + 4 * var(--lg)),
        var(--line-blue) 0 var(--bw))}
    .stop{text-align:left;padding:0 0 0 64px}
    .node{top:9px;left:24px;transform:translate(-50%,0);z-index:1}
    /* Cut the bundle off at the terminus node. */
    .end::before{content:'';position:absolute;left:0;width:56px;top:19px;bottom:-22px;background:var(--surface-page)}
  }
</style>
